import RiskGates

/-!
# Autoformalization harness: reference gates as `Bool` + a counterexample search

A candidate formalization is any function `Limits → State → Order → Bool`.
We compare it with the reference gate in two ways:

1. **Counterexample search** (`findCex`): a deterministic pseudo-random sweep over
   small and "interesting" values (edges, odd reference prices that break division, ...).
   A mismatch is printed as a concrete order + state + limits — something a human can read.
2. **Proof attempt** (generated by `check.py`): `∀ l s o, cand l s o = ref l s o`,
   closed with `simp` + `omega`. If the proof goes through, the candidate is *equivalent*
   for every possible input, not only the tested ones.
-/

namespace Autoformalize
open RiskGates

def refGate : String → Limits → State → Order → Bool
  | "killSwitch", _, s, _ => decide (killOk s)
  | "qty",        l, _, o => decide (qtyOk l o)
  | "notional",   l, _, o => decide (notionalOk l o)
  | "priceBand",  l, _, o => decide (priceBandOk l o)
  | "position",   l, s, o => decide (positionOk l s o)
  | "openOrders", l, s, _ => decide (openOrdersOk l s)
  | "credit",     l, s, o => decide (creditOk l s o)
  | _, _, _, _ => false

/-- Small integer hash (xorshift-multiply) so the sweep is reproducible and well mixed. -/
def mix (x : Nat) : Nat :=
  let x := ((x ^^^ (x >>> 16)) * 0x45d9f3b) % 4294967296
  let x := ((x ^^^ (x >>> 16)) * 0x45d9f3b) % 4294967296
  x ^^^ (x >>> 16)

def pick (seed : Nat) (xs : Array Nat) : Nat := xs[seed % xs.size]!

/-- "Interesting" values: 0, 1, small odds, round numbers, values that do not divide 10000 nicely. -/
def smallVals : Array Nat := #[0, 1, 2, 3, 7, 10, 99, 100, 101, 333, 500, 999, 1000, 1001]
def priceVals : Array Nat := #[0, 1, 7, 333, 334, 350, 9990, 10000, 10010, 47500, 50000, 52500, 52501]
def bpsVals   : Array Nat := #[0, 1, 7, 33, 100, 500, 10000]

def genCase (seed : Nat) : Limits × State × Order :=
  let r := fun k => mix (seed * 64 + k)
  let ref := pick (r 1) priceVals
  -- half the time put the price right around the reference price
  let price := if r 2 % 2 == 0 then pick (r 3) priceVals
               else Int.toNat ((ref : Int) + ((r 4 % 41 : Nat) : Int) - 20)
  let l : Limits :=
    { maxOrderQty := pick (r 5) smallVals, maxNotional := pick (r 6) smallVals * 1000,
      refPrice := ref, bandBps := pick (r 7) bpsVals, maxPosition := pick (r 8) smallVals,
      maxOpenOrders := pick (r 9) smallVals, creditLimit := pick (r 10) smallVals * 1000 }
  let pos : Int := (pick (r 11) smallVals : Int) * (if r 12 % 2 == 0 then 1 else -1)
  let s : State :=
    { position := pos, openOrders := pick (r 13) smallVals,
      usedCredit := pick (r 14) smallVals * 100, killSwitch := r 15 % 5 == 0 }
  let o : Order :=
    { side := if r 16 % 2 == 0 then .buy else .sell, qty := pick (r 17) smallVals, price }
  (l, s, o)

/-- Returns the first counterexample found in `n` cases, if any. -/
def findCex (rule : String) (cand : Limits → State → Order → Bool) (n : Nat := 20000) :
    Option (Limits × State × Order × Bool × Bool) := Id.run do
  for i in [0:n] do
    let (l, s, o) := genCase i
    let c := cand l s o
    let r := refGate rule l s o
    if c != r then return some (l, s, o, c, r)
  return none

def report (name rule : String) (cand : Limits → State → Order → Bool) : IO Unit := do
  match findCex rule cand with
  | none => IO.println s!"[{name}] CEX_SEARCH: no counterexample in 20000 cases"
  | some (l, s, o, c, r) =>
    IO.println s!"[{name}] COUNTEREXAMPLE: candidate={c} reference={r}"
    IO.println s!"  order  = {repr o}"
    IO.println s!"  state  = {repr s}"
    IO.println s!"  limits = {repr l}"

end Autoformalize

/-- The automatic equivalence proof used by `check.py`.
Case-split on the order side, unfold every gate, normalise multiplication order,
then let `omega` (linear integer arithmetic, incl. division by constants) finish. -/
macro "solve_gate" : tactic => `(tactic| (
  intro l s o
  rcases o with ⟨side, qty, price⟩
  cases side <;>
  simp [RiskGates.killOk, RiskGates.qtyOk, RiskGates.notionalOk, RiskGates.priceBandOk,
        RiskGates.positionOk, RiskGates.openOrdersOk, RiskGates.creditOk,
        RiskGates.Order.signedQty, Autoformalize.refGate,
        Nat.mul_comm l.refPrice l.bandBps, Nat.mul_comm price qty] <;>
  first
    | omega
    | (constructor <;> intro h <;> omega)
    | (rw [Bool.eq_iff_iff]; simp; omega)))
